generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SystemConfig {
  id                     String   @id @default(cuid())
  aiProvider             String
  defaultModel           String
  apiBaseUrl             String?
  apiKey                 String?
  browserPath            String?
  promptDefaults         String?
  hideRevenueByDefault   Boolean  @default(false)
  publishRequiresPreview Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model PlatformAccount {
  id               String   @id @default(cuid())
  platform         String
  displayName      String
  credentialBlob   String?
  credentialStatus String   @default("pending")
  fansCount        Int      @default(0)
  revenueYesterday Float    @default(0)
  hideRevenue      Boolean  @default(false)
  isDefault        Boolean  @default(false)
  lastValidatedAt  DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Hotspot {
  id        String   @id @default(cuid())
  source    String
  title     String
  summary   String?
  score     String?
  rawUrl    String?
  canGenerate Boolean @default(true)
  fetchedAt DateTime @default(now())
  createdAt DateTime @default(now())
}

model Draft {
  id          String   @id @default(cuid())
  title       String
  content     String
  platform    String
  accountId   String?
  ownerName   String?
  status      String   @default("draft")
  promptText  String?
  previewHtml String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PublishRecord {
  id        String   @id @default(cuid())
  draftId   String?
  platform  String
  accountId String?
  title     String
  status    String
  errorText String?
  createdAt DateTime @default(now())
}

model Skill {
  id              String   @id @default(cuid())
  name            String
  description     String
  targetPlatforms String
  entryPath       String?
  status          String   @default("registered")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SkillInvocation {
  id         String   @id @default(cuid())
  skillId    String
  accountId  String?
  inputJson  String
  outputJson String?
  status     String
  createdAt  DateTime @default(now())
}
